{
  "name": "pokedex",
  "version": "0.4.0",
  "private": true,
  "description": "A portable, modular Agent Skill for coding agents.",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24"
  },
