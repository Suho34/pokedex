    "format:check": "prettier --check .",
    "validate": "node scripts/validate-skill.mjs"
  },
  "devDependencies": {
    "prettier": "^3.10.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1",
    "zod": "^4.6.7"
  }
}
